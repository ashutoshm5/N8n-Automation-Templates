# ==========================================
# Root Git Ignore Configuration
# n8n Automation Templates Library
# ==========================================

# Environment variables & local secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx

# Decrypted credentials & API exports
*credentials*.json
*decrypted*.json
backup-credentials/
secrets/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor & IDE configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local test media and generated content
# (Prevent large binary files from polluting Git history)
media/
test-media/
inputs/
uploads/
downloads/
*.mp4
*.mov
*.avi
*.mkv
*.jpg
*.jpeg
*.png
*.webp
*.gif

# Docker persistent local volumes (when mapped locally)
.n8n/
n8n_data/
docker_data/

# Logs and runtime databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.sqlite
*.sqlite-journal

# Temporary files and caches
tmp/
temp/
.cache/

# ==========================================
# Explicitly Tracked Workflow Folders
# ==========================================
!**/workflow/
!**/*.json
!**/docs/
!**/assets/
