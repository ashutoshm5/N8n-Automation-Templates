    {
      "parameters": {
        "jsCode": "\nconst raw =\n  $json.content?.parts?.[0]?.text ??\n  $json.text ??\n  $json.output ??\n  $json.response;\n\nif (!raw) {\n  throw new Error('Gemini response text was not found.');\n}\n\nconst cleaned = String(raw)\n  .replace(/^```(?:json)?\\s*/i, '')\n  .replace(/\\s*```$/, '')\n  .trim();\n\nlet result;\n\ntry {\n  result = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error(\n    'Gemini returned invalid JSON: ' + cleaned.slice(0, 500)\n  );\n}\n\nfor (const platform of ['instagram', 'linkedin', 'youtube']) {\n  if (!result[platform]) {\n    throw new Error(`Missing ${platform} content.`);\n  }\n}\n\nreturn {\n  json: {\n    originalFileName: $('Edit Fields').item.json.originalFilename,\n    instagram: result.instagram,\n    linkedin: result.linkedin,\n    youtube: result.youtube,\n    processedAt: new Date().toISOString()\n  }\n};\n"
      },
