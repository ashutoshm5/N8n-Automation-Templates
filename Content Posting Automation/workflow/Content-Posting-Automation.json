        "messages": {
          "values": [
            {
              "content": "=You are a professional social media content strategist specializing in AI, technology, software, and hardware.\n\nAnalyze the following video analysis and create platform-specific content.\n\nVIDEO ANALYSIS:\n{{ JSON.stringify($json.content.parts[0].text) }}\n\nGenerate valid JSON with these keys:\n\n{\n  \"instagram\": {\n    \"caption\": \"\",\n    \"hook\": \"\",\n    \"keywords\": [],\n    \"hashtags\": [],\n    \"cta\": \"\"\n  },\n  \"linkedin\": {\n    \"caption\": \"\",\n    \"keywords\": [],\n    \"hashtags\": [],\n    \"cta\": \"\"\n  },\n  \"youtube\": {\n    \"title\": \"\",\n    \"description\": \"\",\n    \"keywords\": [],\n    \"tags\": [],\n    \"hashtags\": []\n  }\n}\n\nRequirements:\n- Instagram: engaging opening hook, concise caption, relevant hashtags.\n- LinkedIn: professional, insightful caption with a technology-focused perspective.\n- YouTube: searchable title, informative description, relevant tags.\n- Research-free accuracy: do not invent specifications, claims, or facts absent from the analysis.\n- Use relevant SEO keywords naturally.\n- Return only valid JSON, without Markdown code fences."
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
